# Application Settings
APP_NAME="AI Disaster Prediction & Response Platform"
ENVIRONMENT="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# Database
DATABASE_URL="sqlite:///./disaster_platform.db"

# Multi-Hazard Prediction Thresholds (0.0 to 1.0)
RISK_THRESHOLD_MODERATE=0.40
RISK_THRESHOLD_HIGH=0.70
RISK_THRESHOLD_CRITICAL=0.85

# External API Keys (Optional - System includes mock/sample fallback)
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"
NASA_FIRMS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

# Simulation Parameters
SIMULATION_DEFAULT_HOURS=48
CELLULAR_AUTOMATA_TIME_STEP_MIN=15
DEM_GRID_RESOLUTION_METERS=30.0
